FROM hub.indraproject.ir/hubproxy/library/node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
ARG NPM_REGISTRY=https://mirror.abrha.net/repository/npm/
RUN npm ci --no-audit --no-fund --registry="${NPM_REGISTRY}"
COPY . .
RUN npm run build

FROM hub.indraproject.ir/hubproxy/library/alpine:3.20

RUN sed -i 's|https://dl-cdn.alpinelinux.org|https://mirror.arvancloud.ir|g' /etc/apk/repositories \
    && apk add --no-cache nginx gettext-envsubst ca-certificates \
    && mkdir -p /run/nginx

COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY docker/entrypoint.sh /usr/local/bin/ai-therapist-entrypoint
COPY --from=build /app/dist /usr/share/nginx/html
RUN chmod +x /usr/local/bin/ai-therapist-entrypoint

ENV API_UPSTREAM=http://ai-therapist-backend-service.ramona.svc.cluster.local:80
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:80/healthz >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/ai-therapist-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
