{
  "description": "Local-only synthetic execution envelope. Active turns use extensible retrieval/JEV/unified/proposal/background operation names; standalone kind=job documents identify batches and user-scoped analysis without inventing a turn; historical Brain/Generator v1 traces remain valid.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "local_ai_trace.v1"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string"
    },
    "turn_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "success",
        "error",
        "cancelled"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "totals": {
      "$ref": "#/$defs/totals"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "response_complete": {
      "type": "boolean"
    },
    "response_ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "background_status": {
      "enum": [
        "unknown",
        "pending",
        "running",
        "complete"
      ]
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "run_after": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_error_code": {
            "type": "string"
          },
          "payload": {}
        },
        "required": [
          "id",
          "kind",
          "status",
          "attempts",
          "max_attempts",
          "run_after",
          "created_at",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "trace_id",
    "kind",
    "started_at",
    "status",
    "complete",
    "nodes",
    "edges",
    "totals",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theia.local/schemas/local_ai_trace.v1.json",
  "title": "Theia opt-in local AI execution trace v1",
  "$defs": {
    "diagnostic": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "value": {},
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "value",
        "sha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "prompt_composition"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/prompt_part"
                }
              }
            }
          }
        }
      ]
    },
    "estimate": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "method": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "source",
        "tokens",
        "method",
        "bytes"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "provider",
        "model",
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "latency_ns"
      ],
      "additionalProperties": false
    },
    "stage_usage": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "actual_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "actual_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "actual_cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_input_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "calls",
        "actual_input_tokens",
        "actual_output_tokens",
        "actual_cached_tokens",
        "estimated_cost_micro_usd",
        "estimated_input_tokens"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "execution",
            "data"
          ]
        },
        "from_path": {
          "type": "string"
        },
        "to_path": {
          "type": "string"
        },
        "evidence": {
          "enum": [
            "exact_json_value_match",
            "instrumented_binding"
          ]
        },
        "relation": {
          "enum": [
            "copy",
            "transform",
            "regeneration"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence": {
                "const": "instrumented_binding"
              }
            },
            "required": [
              "evidence"
            ]
          },
          "then": {
            "required": [
              "from_path",
              "to_path",
              "relation"
            ]
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^n[0-9]{6,}$"
        },
        "operation": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ns": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "running",
            "success",
            "error",
            "cancelled",
            "skipped"
          ]
        },
        "reason": {
          "type": "string"
        },
        "input": {},
        "output": {},
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "error": {
          "$ref": "#/$defs/diagnostic"
        },
        "provider_usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usage"
          }
        },
        "estimates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/estimate"
          }
        },
        "embedding": {
          "$ref": "#/$defs/shared_embedding"
        }
      },
      "required": [
        "id",
        "operation",
        "sequence",
        "started_at",
        "duration_ns",
        "status",
        "input",
        "output",
        "artifacts",
        "provider_usage",
        "estimates"
      ],
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "properties": {
        "provider_calls": {
          "type": "integer",
          "minimum": 0
        },
        "reported_calls": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_usage_calls": {
          "type": "integer",
          "minimum": 0
        },
        "actual_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "actual_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "actual_cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "by_stage": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stage_usage"
          }
        },
        "estimated_input_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "provider_calls",
        "reported_calls",
        "unknown_usage_calls",
        "actual_input_tokens",
        "actual_output_tokens",
        "actual_cached_tokens",
        "estimated_cost_micro_usd",
        "by_stage",
        "estimated_input_tokens"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^n[0-9]{6,}$"
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:input|output|artifacts)(?:/(?:[^~/]|~[01])*)*$"
        }
      },
      "required": [
        "node_id",
        "path"
      ],
      "additionalProperties": false
    },
    "prompt_component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "parent": {
          "type": "integer",
          "minimum": 0
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "required": [
        "name",
        "start_byte",
        "end_byte",
        "sources"
      ],
      "additionalProperties": false
    },
    "prompt_part": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "state",
            "instructions"
          ]
        },
        "rendered": {
          "$ref": "#/$defs/reference"
        },
        "source": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prompt_component"
          }
        }
      },
      "required": [
        "name",
        "role",
        "rendered",
        "components"
      ],
      "additionalProperties": false
    },
    "shared_embedding": {
      "type": "object",
      "properties": {
        "computation_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "input_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "consumer": {
          "type": "string"
        },
        "cache_outcome": {
          "enum": [
            "hit",
            "miss",
            "inflight"
          ]
        },
        "outcome": {
          "enum": [
            "success",
            "failed",
            "timeout",
            "cancelled"
          ]
        },
        "origin_trace_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin_node_id": {
          "type": "string"
        },
        "origin_turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "wait_duration_ns": {
          "type": "integer",
          "minimum": 0
        },
        "compute_duration_ns": {
          "type": "integer",
          "minimum": 0
        },
        "provider_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "computation_id",
        "provider",
        "model",
        "dimensions",
        "input_hash",
        "cache_outcome",
        "provider_attempts"
      ],
      "additionalProperties": false
    }
  }
}
