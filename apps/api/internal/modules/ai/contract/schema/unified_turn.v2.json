{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theia.app/schemas/unified_turn.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reply",
    "state_proposals",
    "background_requests",
    "future_hints"
  ],
  "properties": {
    "schema_version": {
      "const": "unified_turn.v2"
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "conversation",
        "used_context_ids",
        "depends_on"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "conversation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intent": {
              "enum": [
                "share_distress",
                "seek_advice",
                "answer_question",
                "report_exercise",
                "ask_recall",
                "ask_info",
                "small_talk",
                "disagree_correct",
                "request_technique",
                "disclose_event",
                "other"
              ]
            },
            "objective": {
              "enum": [
                "reflect",
                "validate_and_support",
                "clarify",
                "explore",
                "provide_insight",
                "provide_guidance",
                "offer_intervention",
                "continue_intervention",
                "close_or_pause_intervention",
                "review_progress",
                "summarize",
                "repair",
                "answer_direct",
                "safety_support",
                "boundary"
              ]
            }
          },
          "required": [
            "intent",
            "objective"
          ]
        },
        "used_context_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/any_id"
          },
          "maxItems": 24
        },
        "depends_on": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    "state_proposals": {
      "type": "array",
      "maxItems": 8,
      "items": {}
    },
    "background_requests": {
      "type": "array",
      "maxItems": 2,
      "items": {}
    },
    "future_hints": {
      "type": "array",
      "maxItems": 4,
      "items": {}
    }
  },
  "$defs": {
    "memory_id": {
      "$ref": "#/$defs/any_id"
    },
    "message_id": {
      "$ref": "#/$defs/any_id"
    },
    "any_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "slot_name": {
      "enum": [
        "__INJECT:schemas/problem_understanding.yaml#slots__"
      ]
    },
    "protocol_id": {
      "enum": [
        "__INJECT:protocols/*__"
      ]
    },
    "hypothesis_tag": {
      "enum": [
        "__INJECT:config/hypothesis_tags.yaml__"
      ]
    },
    "proposal_session_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value",
        "depends_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/proposal_id"
        },
        "kind": {
          "const": "session_intent"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "venting",
                "exploring",
                "problem_solving",
                "exercise",
                "checking_in",
                "safety",
                "small_talk"
              ]
            },
            "summary": {
              "type": "string",
              "maxLength": 1800
            },
            "answered_pending": {
              "type": "boolean"
            }
          },
          "required": [
            "answered_pending"
          ]
        },
        "depends_on": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    "proposal_thread_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value",
        "depends_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/proposal_id"
        },
        "kind": {
          "const": "thread_intent"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "relation": {
              "enum": [
                "continues",
                "shifts",
                "new",
                "returns_to_paused"
              ]
            },
            "target_id": {
              "$ref": "#/$defs/any_id"
            },
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "goal": {
              "type": "string",
              "maxLength": 240
            },
            "phase": {
              "enum": [
                "exploring",
                "understanding_sufficient",
                "working",
                "maintaining",
                "resolved"
              ]
            },
            "slots": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "slot",
                  "value",
                  "status",
                  "evidence"
                ],
                "properties": {
                  "slot": {
                    "$ref": "#/$defs/slot_name"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "status": {
                    "enum": [
                      "reported",
                      "inferred"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "$ref": "#/$defs/message_id"
                    }
                  },
                  "declined": {
                    "type": "boolean"
                  }
                }
              }
            },
            "hypotheses": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "evidence"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "support",
                      "contradict",
                      "propose",
                      "user_endorsed",
                      "user_rejected"
                    ]
                  },
                  "id": {
                    "$ref": "#/$defs/memory_id"
                  },
                  "tag": {
                    "$ref": "#/$defs/hypothesis_tag"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "$ref": "#/$defs/message_id"
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "op": {
                          "const": "propose"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "tag"
                      ],
                      "not": {
                        "required": [
                          "id"
                        ]
                      }
                    },
                    "else": {
                      "required": [
                        "id"
                      ]
                    }
                  }
                ]
              }
            },
            "related_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/any_id"
              },
              "maxItems": 4
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "thread_id": {
                    "$ref": "#/$defs/any_id"
                  },
                  "op": {
                    "enum": [
                      "pause",
                      "resume",
                      "dormant",
                      "resolve"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 60
                  }
                },
                "required": [
                  "thread_id",
                  "op",
                  "reason"
                ]
              },
              "maxItems": 4
            }
          },
          "required": [
            "relation",
            "slots",
            "hypotheses"
          ]
        },
        "depends_on": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    "proposal_protocol_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value",
        "depends_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/proposal_id"
        },
        "kind": {
          "const": "protocol_intent"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "directive": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "enum": [
                    "offer",
                    "advance",
                    "repeat_step",
                    "adapt",
                    "pause",
                    "stop",
                    "complete",
                    "decline"
                  ]
                },
                "protocol_id": {
                  "$ref": "#/$defs/protocol_id"
                },
                "step_outcome": {
                  "enum": [
                    "success",
                    "partial",
                    "stuck",
                    "distress",
                    "decline",
                    "off_topic"
                  ]
                },
                "inputs_captured": {
                  "type": "object",
                  "maxProperties": 6,
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 240
                  }
                },
                "note_tag": {
                  "enum": [
                    "user_declined",
                    "too_distressed",
                    "needs_simpler",
                    "topic_shift",
                    "completed_all"
                  ]
                }
              }
            },
            "user_affirmed": {
              "type": "boolean"
            },
            "expected_status": {
              "enum": [
                "offered",
                "active",
                "paused",
                "stopped",
                "completed",
                "declined"
              ]
            },
            "expected_step": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "directive",
            "user_affirmed",
            "expected_status",
            "expected_step"
          ]
        },
        "depends_on": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    "proposal_open_loops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value",
        "depends_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/proposal_id"
        },
        "kind": {
          "const": "open_loops"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": [
                  "add",
                  "close",
                  "expire"
                ]
              },
              "id": {
                "$ref": "#/$defs/any_id"
              },
              "kind": {
                "enum": [
                  "unanswered_question",
                  "exercise_review",
                  "confirm_fact",
                  "resume_protocol",
                  "user_commitment"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 300
              },
              "ref": {
                "$ref": "#/$defs/any_id"
              }
            },
            "required": [
              "op"
            ]
          },
          "maxItems": 8
        },
        "depends_on": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    "proposal_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value",
        "depends_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/proposal_id"
        },
        "kind": {
          "const": "preferences"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "length": {
              "enum": [
                "minimal",
                "short",
                "medium",
                "long"
              ]
            },
            "tone": {
              "enum": [
                "warm_steady",
                "gentle",
                "calm_direct",
                "light",
                "formal"
              ]
            },
            "address_form": {
              "type": "string",
              "maxLength": 60
            },
            "avoid_add": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 80
              },
              "maxItems": 20
            },
            "avoid_remove": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 80
              },
              "maxItems": 20
            }
          },
          "required": [
            "avoid_add",
            "avoid_remove"
          ]
        },
        "depends_on": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    "proposal_risk_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value",
        "depends_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/proposal_id"
        },
        "kind": {
          "const": "risk_read"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "categories",
            "reason_tag"
          ],
          "properties": {
            "level": {
              "enum": [
                "low",
                "elevated",
                "high",
                "imminent"
              ]
            },
            "categories": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "enum": [
                  "suicidal_ideation",
                  "self_harm",
                  "harm_to_others",
                  "abuse_disclosure",
                  "medical_emergency",
                  "substance_crisis",
                  "other"
                ]
              }
            },
            "reason_tag": {
              "type": "string",
              "maxLength": 60
            }
          }
        },
        "depends_on": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    "background_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "objective",
        "topic",
        "queries",
        "evidence_ids",
        "depends_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/proposal_id"
        },
        "kind": {
          "enum": [
            "memory_intelligence",
            "reflection"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "depends_on": {
          "$ref": "#/$defs/dependencies"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "thread_ids"
          ],
          "properties": {
            "kind": {
              "enum": [
                "user",
                "threads"
              ]
            },
            "thread_ids": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    "future_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "resource_ids",
        "ttl_turns"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "resource_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "ttl_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    }
  }
}
