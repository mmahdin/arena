{
  "$id": "https://theia.app/schemas/safety.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "level",
    "categories",
    "confidence"
  ],
  "properties": {
    "level": {
      "enum": [
        "none",
        "low",
        "elevated",
        "high",
        "imminent"
      ]
    },
    "categories": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "enum": [
          "suicidal_ideation",
          "self_harm",
          "harm_to_others",
          "abuse_disclosure",
          "medical_emergency",
          "substance_crisis",
          "other"
        ]
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "context_flags": {
      "type": "array",
      "items": {
        "enum": [
          "quoted",
          "fictional",
          "hypothetical",
          "third_person",
          "past_event"
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
