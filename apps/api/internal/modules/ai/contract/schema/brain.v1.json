{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theia.app/schemas/brain.v1.json",
  "title": "BrainDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "turn_analysis",
    "understanding_update",
    "needs",
    "decision",
    "response_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "brain.v1"
    },
    "turn_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "message_type",
        "thread_relation",
        "emotions",
        "past_references",
        "answered_pending_question",
        "ambiguities",
        "action_cue",
        "user_readiness"
      ],
      "properties": {
        "intent": {
          "enum": [
            "share_distress",
            "seek_advice",
            "answer_question",
            "report_exercise",
            "ask_recall",
            "ask_info",
            "small_talk",
            "disagree_correct",
            "request_technique",
            "disclose_event",
            "other"
          ]
        },
        "message_type": {
          "enum": [
            "disclosure",
            "question",
            "answer",
            "report",
            "request",
            "meta",
            "greeting"
          ]
        },
        "thread_relation": {
          "enum": [
            "continues",
            "shifts",
            "new",
            "returns_to_paused"
          ]
        },
        "target_thread_id": {
          "$ref": "#/$defs/thread_id"
        },
        "new_thread_topic": {
          "type": "string",
          "maxLength": 80
        },
        "emotions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "intensity"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/emotion_label"
              },
              "intensity": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        },
        "past_references": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phrase",
              "resolved_to",
              "ambiguous"
            ],
            "properties": {
              "phrase": {
                "type": "string",
                "maxLength": 80
              },
              "resolved_to": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "$ref": "#/$defs/any_id"
                }
              },
              "ambiguous": {
                "type": "boolean"
              }
            }
          }
        },
        "answered_pending_question": {
          "type": "boolean"
        },
        "ambiguities": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "note"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "reference",
                  "emotion",
                  "situation",
                  "goal",
                  "timeframe",
                  "person"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 100
              }
            }
          }
        },
        "action_cue": {
          "type": "boolean"
        },
        "user_readiness": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "correction_target": {
          "$ref": "#/$defs/memory_id"
        }
      }
    },
    "understanding_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slots",
        "hypotheses",
        "unknowns"
      ],
      "properties": {
        "thread_id": {
          "$ref": "#/$defs/thread_id"
        },
        "slots": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "value",
              "status",
              "evidence"
            ],
            "properties": {
              "slot": {
                "$ref": "#/$defs/slot_name"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "status": {
                "enum": [
                  "reported",
                  "inferred"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "$ref": "#/$defs/message_id"
                }
              },
              "declined": {
                "type": "boolean"
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "evidence"
            ],
            "properties": {
              "op": {
                "enum": [
                  "support",
                  "contradict",
                  "propose",
                  "user_endorsed",
                  "user_rejected"
                ]
              },
              "id": {
                "$ref": "#/$defs/memory_id"
              },
              "tag": {
                "$ref": "#/$defs/hypothesis_tag"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "$ref": "#/$defs/message_id"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "op": {
                      "const": "propose"
                    }
                  }
                },
                "then": {
                  "required": [
                    "tag"
                  ],
                  "not": {
                    "required": [
                      "id"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "id"
                  ]
                }
              }
            ]
          }
        },
        "unknowns": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "session_mode": {
          "enum": [
            "venting",
            "exploring",
            "problem_solving",
            "exercise",
            "checking_in",
            "safety",
            "small_talk"
          ]
        },
        "session_summary_delta": {
          "type": "string",
          "maxLength": 300
        },
        "thread_phase_proposal": {
          "enum": [
            "exploring",
            "understanding_sufficient",
            "working",
            "maintaining",
            "resolved"
          ]
        }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs_formulation",
        "memory_worthy"
      ],
      "properties": {
        "needs_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "query",
            "why"
          ],
          "properties": {
            "kind": {
              "enum": [
                "entity",
                "topic",
                "time_window",
                "item"
              ]
            },
            "query": {
              "type": "string",
              "maxLength": 100
            },
            "why": {
              "enum": [
                "reference_unresolved",
                "missing_background",
                "verify_fact"
              ]
            }
          }
        },
        "needs_formulation": {
          "type": "boolean"
        },
        "memory_worthy": {
          "type": "boolean"
        },
        "memory_tags": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "enum": [
              "recurrence",
              "goal",
              "preference",
              "event",
              "hypothesis_support",
              "correction",
              "feedback",
              "protocol_outcome"
            ]
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_objective",
        "rationale_tags",
        "alternatives_considered",
        "confidence"
      ],
      "properties": {
        "primary_objective": {
          "enum": [
            "reflect",
            "validate_and_support",
            "clarify",
            "explore",
            "provide_insight",
            "provide_guidance",
            "offer_intervention",
            "continue_intervention",
            "close_or_pause_intervention",
            "review_progress",
            "summarize",
            "repair",
            "answer_direct",
            "boundary"
          ]
        },
        "rationale_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/rationale_tag"
          }
        },
        "alternatives_considered": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/objective_no_safety"
          }
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "response_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skills",
        "question",
        "tone",
        "length",
        "permitted_context_ids",
        "must_avoid"
      ],
      "properties": {
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "secondary"
          ],
          "properties": {
            "primary": {
              "$ref": "#/$defs/skill_id"
            },
            "secondary": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/skill_id"
              }
            }
          }
        },
        "question": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "max_count"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "purpose": {
              "enum": [
                "close_gap",
                "invite_detail",
                "check_readiness",
                "confirm",
                "choose",
                "none"
              ]
            },
            "slot": {
              "$ref": "#/$defs/slot_name"
            },
            "max_count": {
              "enum": [
                0,
                1
              ]
            }
          }
        },
        "tone": {
          "enum": [
            "warm_steady",
            "gentle",
            "calm_direct",
            "light",
            "formal"
          ]
        },
        "length": {
          "enum": [
            "minimal",
            "short",
            "medium",
            "long"
          ]
        },
        "permitted_context_ids": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/any_id"
          }
        },
        "must_avoid": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/avoid_tag"
          }
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "enum": [
                "offer",
                "advance",
                "repeat_step",
                "adapt",
                "pause",
                "stop",
                "complete",
                "decline"
              ]
            },
            "protocol_id": {
              "$ref": "#/$defs/protocol_id"
            },
            "step_outcome": {
              "enum": [
                "success",
                "partial",
                "stuck",
                "distress",
                "decline",
                "off_topic"
              ]
            },
            "inputs_captured": {
              "type": "object",
              "maxProperties": 6,
              "additionalProperties": {
                "type": "string",
                "maxLength": 240
              }
            },
            "note_tag": {
              "enum": [
                "user_declined",
                "too_distressed",
                "needs_simpler",
                "topic_shift",
                "completed_all"
              ]
            }
          }
        },
        "voice_hypothesis_id": {
          "$ref": "#/$defs/memory_id"
        }
      }
    },
    "risk_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "categories",
        "reason_tag"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "elevated",
            "high",
            "imminent"
          ]
        },
        "categories": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "enum": [
              "suicidal_ideation",
              "self_harm",
              "harm_to_others",
              "abuse_disclosure",
              "medical_emergency",
              "substance_crisis",
              "other"
            ]
          }
        },
        "reason_tag": {
          "type": "string",
          "maxLength": 60
        }
      }
    }
  },
  "$defs": {
    "thread_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "memory_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "message_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "any_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "emotion_label": {
      "enum": [
        "__INJECT:config/emotions.yaml__"
      ]
    },
    "slot_name": {
      "enum": [
        "__INJECT:schemas/problem_understanding.yaml#slots__"
      ]
    },
    "skill_id": {
      "enum": [
        "__INJECT:skills/*__"
      ]
    },
    "protocol_id": {
      "enum": [
        "__INJECT:protocols/*__"
      ]
    },
    "rationale_tag": {
      "enum": [
        "__INJECT:config/rationale_tags.yaml__"
      ]
    },
    "avoid_tag": {
      "enum": [
        "__INJECT:config/avoid_tags.yaml__"
      ]
    },
    "hypothesis_tag": {
      "enum": [
        "__INJECT:config/hypothesis_tags.yaml__"
      ]
    },
    "objective_no_safety": {
      "$ref": "#/properties/decision/properties/primary_objective"
    }
  }
}
