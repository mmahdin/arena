// MON-01B: only the Go-created, strictly sanitized JSONL spool is mounted.
// No Docker socket, container discovery, OTLP content spans, or Inspector files.
logging {
  level  = "warn"
  format = "logfmt"
}

loki.source.file "theia_safe_jsonl" {
  targets = [{
    __path__      = "/var/log/theia/theia-safe.jsonl*",
    service_name  = "theia-api",
    environment   = "local",
  }]
  file_match {
    enabled = true
    sync_period = "5s"
  }
  forward_to = [loki.process.safe_json.receiver]
}

loki.process "safe_json" {
  stage.json {
    expressions = {
      level = "level",
    }
    drop_malformed = true
  }
  // Level is a bounded enum set at the Go export boundary. Never index IDs.
  stage.labels {
    values = {
      level = "level",
    }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
