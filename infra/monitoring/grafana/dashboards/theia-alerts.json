{
  "uid": "theia-alerting-local",
  "title": "Theia - Incident Alerts",
  "tags": [
    "theia",
    "monitoring",
    "synthetic",
    "alerts"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active firing alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "theia-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Alert state by rule",
      "datasource": {
        "type": "prometheus",
        "uid": "theia-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alertname, alertstate) (ALERTS{alertstate=~\"pending|firing\"})",
          "legendFormat": "{{alertname}} / {{alertstate}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Private monitoring scrape targets",
      "datasource": {
        "type": "prometheus",
        "uid": "theia-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"theia-api|theia-alertmanager\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Worker heartbeat age (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "theia-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - theia_worker_heartbeat_success_timestamp_seconds",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 5xx ratio, 5 minute window",
      "datasource": {
        "type": "prometheus",
        "uid": "theia-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(theia_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(theia_http_requests_total[5m])), 0.000001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM failed attempt ratio, 10 minute window",
      "datasource": {
        "type": "prometheus",
        "uid": "theia-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(theia_llm_attempts_total{status=\"failed\"}[10m])) / clamp_min(sum(rate(theia_llm_attempts_total[10m])), 0.000001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    }
  ]
}
