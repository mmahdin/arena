{
  "uid": "theia-engineering-logs-local",
  "title": "Theia · Engineering Logs",
  "tags": ["theia", "local", "synthetic", "logs"],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Logs by severity (5m)", "type": "timeseries",
      "datasource": {"type": "loki", "uid": "theia-loki"},
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 7},
      "targets": [{"refId": "A", "expr": "sum by (level) (count_over_time({service_name=\"theia-api\",environment=\"local\"}[5m]))", "queryType": "range"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 2, "title": "Recent operational events (metadata only)", "type": "logs",
      "datasource": {"type": "loki", "uid": "theia-loki"},
      "gridPos": {"x": 0, "y": 7, "w": 24, "h": 12},
      "targets": [{"refId": "A", "expr": "{service_name=\"theia-api\",environment=\"local\"} | json", "queryType": "range"}],
      "options": {"showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "enableLogDetails": true}
    }
  ]
}
