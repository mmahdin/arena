{
  "realm": "theia-staff",
  "enabled": true,
  "displayName": "Theia Staff (staging)",
  "sslRequired": "all",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(14) and notUsername",
  "clients": [
    {
      "clientId": "theia-staff-bff",
      "name": "Theia Staff BFF",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${THEIA_STAFF_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${AUTH_STAFF_ORIGIN}/auth/staff/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${AUTH_STAFF_ORIGIN}/",
        "backchannel.logout.url": "${THEIA_BACKEND_INTERNAL_ORIGIN}/auth/staff/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "frontchannelLogout": false
    }
  ],
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fa"
  ],
  "defaultLocale": "fa",
  "loginTheme": "theia-sms"
}
