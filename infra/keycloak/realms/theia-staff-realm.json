{
  "realm": "theia-staff",
  "enabled": true,
  "displayName": "Theia Staff (LOCAL ONLY)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(14) and notUsername",
  "clients": [
    {
      "clientId": "theia-staff-bff",
      "name": "Theia Staff BFF",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${THEIA_STAFF_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://admin.localhost:8080/auth/staff/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://admin.localhost:8080/",
        "backchannel.logout.url": "http://api:8080/auth/staff/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "frontchannelLogout": false
    }
  ]
}
