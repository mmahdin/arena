FROM maven:3.9.11-eclipse-temurin-21 AS sms-build
WORKDIR /build
COPY infra/keycloak/sms-spi/pom.xml ./pom.xml
COPY infra/keycloak/sms-spi/src ./src
RUN mvn --batch-mode --no-transfer-progress -DskipTests=false verify

FROM quay.io/keycloak/keycloak:26.8.2 AS keycloak-build
COPY --from=sms-build /build/target/theia-sms-otp-1.0.0.jar /opt/keycloak/providers/theia-sms-otp.jar
COPY infra/keycloak/themes/theia-sms /opt/keycloak/themes/theia-sms
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.8.2
COPY --from=keycloak-build /opt/keycloak/ /opt/keycloak/
COPY infra/keycloak/realms/staging/ /opt/keycloak/data/import/
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
