+import type { CaseFile, Report, Task, Visit } from '@/types';
+import { isOpenTask, sortTasks } from './domain';
+import { dayKey, daysUntil } from './jalali';
+
+/** The assignment is the primary object; a visit or report is supporting data. */
+export function assignedDay(task: Task, visits: Visit[]): string {
+  const visit = task.visitId ? visits.find((v) => v.id === task.visitId) : undefined;
+  return visit && task.type !== 'report' ? visit.date : task.dueDate;
+}
+
+export function assignedTime(task: Task, visits: Visit[]): string | undefined {
+  const visit = task.visitId ? visits.find((v) => v.id === task.visitId) : undefined;
+  if (visit && task.type !== 'report') return visit.time;
+  if (task.type === 'meeting') {
+    const digits = (task.description ?? '').replace(/[۰-۹]/g, (digit) => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(digit)));
+    const match = digits.match(/ساعت\s*(\d{1,2}):(\d{2})/);
+    if (match) return `${match[1].padStart(2, '0')}:${match[2]}`;
+  }
+  return undefined;
+}
+
+export function relatedCase(task: Task, cases: CaseFile[]): CaseFile | undefined {
+  return task.caseId ? cases.find((c) => c.id === task.caseId) : undefined;
+}
+
+export function relatedReport(task: Task, reports: Report[], visits: Visit[]): Report | undefined {
+  if (task.reportId) return reports.find((r) => r.id === task.reportId);
+  if (task.type !== 'report') return undefined;
+  const visit = task.visitId ? visits.find((v) => v.id === task.visitId) : undefined;
+  return visit?.reportId ? reports.find((r) => r.id === visit.reportId) : undefined;
+}
+
+/** Each open assignment appears in exactly one section on the main screen. */
+export function workSections(tasks: Task[], visits: Visit[], now: Date = new Date()) {
+  const key = dayKey(now);
+  const open = sortTasks(tasks.filter(isOpenTask));
+  const urgent: Task[] = [];
+  const today: Task[] = [];
+  const upcoming: Task[] = [];
+  for (const task of open) {
+    const day = assignedDay(task, visits);
+    if (task.status === 'revision' || task.status === 'blocked' || day < key) urgent.push(task);
+    else if (day === key) today.push(task);
+    else upcoming.push(task);
+  }
+  urgent.sort((a, b) => {
+    const weight = (t: Task) => t.status === 'revision' ? 0 : t.status === 'blocked' ? 1 : 2;
+    return weight(a) - weight(b) || assignedDay(a, visits).localeCompare(assignedDay(b, visits));
+  });
+  today.sort((a, b) => (assignedTime(a, visits) ?? '99:99').localeCompare(assignedTime(b, visits) ?? '99:99'));
+  upcoming.sort((a, b) => assignedDay(a, visits).localeCompare(assignedDay(b, visits)));
+  const completedToday = tasks.filter((t) => t.status === 'done' && t.completedAt && dayKey(t.completedAt) === key);
+  return { urgent, today, upcoming, completedToday };
+}
+
+export function workTone(task: Task, visits: Visit[], now: Date = new Date()) {
+  if (task.status === 'done') return 'success' as const;
+  if (task.status === 'blocked') return 'danger' as const;
+  if (task.status === 'revision') return 'warning' as const;
+  if (daysUntil(assignedDay(task, visits), now) < 0) return 'danger' as const;
+  return 'neutral' as const;
+}
