+  const highlight = task.status === 'revision' || task.status === 'blocked' || (tone === 'danger' && task.status !== 'done');
+  const urgentPriority = task.priority === 'critical' && task.status !== 'done' && !highlight;
+  const linkedVisit = task.type !== 'report' && task.visitId ? visits.find((v) => v.id === task.visitId) : undefined;
+  const dateAndTime = `${faDate(date, { year: false })}${time ? ` · ساعت ${faTime(time)}` : ''}`;
+  const when = showDate || (date < dayKey(new Date()) && task.status !== 'done') ? dateAndTime : time ? `ساعت ${faTime(time)}` : deadlineLabel(date);
+
+  return (
+    <Link
+      to={`/tasks/${task.id}`}
+      className="press flex min-h-[86px] items-center gap-3 rounded-lg border border-line bg-surface px-3.5 py-3 shadow-xs transition-colors hover:border-line-strong hover:bg-sunken/30"
+    >
+      <span className={cn('grid size-10 shrink-0 place-items-center rounded-md', highlight ? 'bg-warning-soft text-warning' : 'bg-sunken text-ink-2')}>
+        <Icon className="size-[19px]" strokeWidth={2} aria-hidden />
+      </span>
